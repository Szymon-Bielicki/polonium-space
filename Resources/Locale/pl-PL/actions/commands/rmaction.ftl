# rmaction
cmd-rmaction-desc = Usuwa akcję z jednostki.
// Removes an action from an entity.
cmd-rmaction-help = Usuń akcję <ActionUid> z <EntityUid>.
// rmaction <EntityUid> <ActionUid>

cmd-rmaction-invalid-args = Potrzebuje dokładnie 2 argumentów.
// Expected exactly 2 arguments.
cmd-rmaction-actions-not-found = Wybrana jednostka nie może użyć akcji.
// Target entity cannot use actions.
cmd-rmaction-not-an-action = Wybrana jednostka nie jest akcją.
// Target entity is not an action.

cmd-rmaction-player-completion = <EntityUid>
cmd-rmaction-action-completion = <ActionUid>

cmd-rmaction-action-info = {$action}
