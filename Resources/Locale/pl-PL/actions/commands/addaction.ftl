# addaction
cmd-addaction-desc = Dodaj akcję do wybranej jednostki. Akcja nie zadziała, gdy cel potrzebuje użycia dodatkowych komponentów na ich jednosce (takie jak Dragon's Devour). 
// Adds an action to the target entity. The action will not work if the target requires an additional component on their entity (such as Dragon's Devour).
cmd-addaction-help = dodaj akcję <ActionPrototype> do <EntityUid>
// addaction <EntityUid> <ActionPrototype>

cmd-addaction-invalid-args = Potrzebne są dokładnie 2 argumenty.
// Expected exactly 2 arguments.
cmd-addaction-actions-not-found = Wybrana jednostka nie może użyć akcji.
// Target entity cannot use actions.
cmd-addaction-action-not-found = Nie można znaleść pasującej akcji do prototypu {$action}.
// Can't find matching action prototype {$action}.
cmd-addaction-adding-failed = Błąd przy dodaniu akcji.
// Failed to add the action.

cmd-addaction-player-completion = <EntityUid>
cmd-addaction-action-completion = <ActionProto>
